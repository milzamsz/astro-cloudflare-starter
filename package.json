{
  "name": "astro-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "Multilingual marketing + blog + docs starter with Astro and Cloudflare Pages",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run type-check && pnpm run check:kpis && pnpm run validate:i18n && pnpm run validate:registry && pnpm run validate:secrets",
    "lint:js": "oxlint && eslint \"src/**/*.astro\"",
    "lint:css": "stylelint src/styles/",
    "type-check": "pnpm run type-check:ts && pnpm run type-check:astro",
    "type-check:ts": "tsc --noEmit -p tsconfig.json",
    "type-check:astro": "astro check",
    "check:kpis": "node scripts/check-kpis.mjs",
    "validate:i18n": "node scripts/validate-i18n.js",
    "validate:registry": "node scripts/validate-registry.mjs",
    "validate:secrets": "node scripts/validate-secrets.cjs",
    "format": "prettier --write 'src/**/*.{astro,ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "wrangler pages deploy dist",
    "cf:types": "wrangler types",
    "postbuild": "node scripts/generate-media-manifest.cjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/simple-icons": "^1.2.102",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "astro-icon": "^1.2.0",
    "clsx": "^2.1.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.43.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-oxlint": "^1.94.0",
    "globals": "^17.14.0",
    "oxlint": "^1.94.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
