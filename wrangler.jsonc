{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "astro-cloudflare",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "./dist",
	// Optional: R2 bucket for large media + the cleanup function (functions/api/cleanup.ts).
	// Remove this block if you don't use R2.
	"r2_buckets": [
		{
			"binding": "R2_MEDIA",
			"bucket_name": "astro-media"
		}
	]
	// Note: `vars` here are runtime bindings for Pages Functions only. The build
	// image's pnpm version must be set as a build environment variable in the
	// Pages dashboard: PNPM_VERSION=12.21.0 (see SETUP.md).
}
