{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "astro-cloudflare-starter",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "./dist",
	// Optional: R2 bucket for large media + the cleanup function (functions/api/cleanup.ts).
	// Remove this block if you don't use R2.
	"r2_buckets": [
		{
			"binding": "R2_MEDIA",
			"bucket_name": "astro-media"
		}
	],
	// With a Wrangler config, Pages manages the project's environment variables
	// from this file (the dashboard only allows secrets). The build image reads
	// PNPM_VERSION to pick pnpm, so keep it in sync with "packageManager".
	// Pages uses the production branch's copy, so a change applies once merged.
	"vars": {
		"PNPM_VERSION": "12.21.0"
	}
}
