{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "astro-cloudflare",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "./dist",
	// Optional: R2 bucket for large media + the cleanup function (functions/api/cleanup.ts).
	// Remove this block if you don't use R2.
	"r2_buckets": [
		{
			"binding": "R2_MEDIA",
			"bucket_name": "astro-media"
		}
	],
	// Cloudflare Pages build image picks the pnpm version from this variable.
	// Keep in sync with "packageManager" in package.json.
	"vars": {
		"PNPM_VERSION": "12.21.0"
	}
}
