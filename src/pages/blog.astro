---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import { siteConfig } from "../config/site.config";
import { BlogListing } from "../components/blog/index";
import { blogListPath, getBlogListing, paginate } from "../lib/blog";
import type { Locale } from "../lib/site-config";

// Page 1 of the unfiltered listing. Later pages live at /blog/page/[page] and
// tag filters at /blog/tag/[tag] — all prerendered, no query strings.
const locale = (Astro.currentLocale || "en") as Locale;
const { posts, featured, rest, tags } = await getBlogListing(locale);
const page = paginate(rest, 1, siteConfig.blog.postsPerPage);
---

<BaseLayout
  title={t(locale, "nav.blog")}
  description={t(locale, "nav.blog")}
  locale={locale}
  path={blogListPath(locale)}
>
  <BlogListing
    locale={locale}
    posts={page.posts}
    featured={featured}
    totalCount={posts.length}
    currentPage={1}
    totalPages={page.totalPages}
    tags={tags}
  />
</BaseLayout>
