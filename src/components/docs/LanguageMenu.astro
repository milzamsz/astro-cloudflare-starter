---
/**
 * Language dropdown that opens upward (it sits at the bottom of the sidebar).
 * Renders nothing while only one locale is configured (src/config/i18n.config.ts).
 */
import { Icon } from "astro-icon/components";
import { i18nConfig } from "../../config/i18n.config";
import { docsLocaleOf, docsUi, stripLocale } from "../../lib/docs";

const path = Astro.url.pathname;
const locale = docsLocaleOf(path);
const base = stripLocale(path);
const items = i18nConfig.locales.map((code) => ({
  code,
  label: i18nConfig.localeLabels[code],
  href: code === i18nConfig.defaultLocale ? base : `/${code}${base}`,
  active: code === locale,
}));
const current = items.find((i) => i.active)!;
---

{
  items.length > 1 && (
    <details class="lang" data-lang-menu>
      <summary aria-label={docsUi(locale).language}>
        <Icon name="lucide:languages" size={16} aria-hidden="true" />
        <span>{current.label}</span>
        <Icon class="chevron" name="lucide:chevron-up" size={16} aria-hidden="true" />
      </summary>
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.href} lang={i.code} hreflang={i.code} aria-current={i.active ? "true" : undefined}>
              {i.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-lang-menu]");
  if (menu) {
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .lang {
    position: relative;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    color: var(--sl-color-gray-1);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    flex: 1;
  }
  .chevron {
    transition: transform 0.15s ease;
  }
  [open] .chevron {
    transform: rotate(180deg);
  }
  ul {
    position: absolute;
    inset-inline: 0;
    bottom: calc(100% + 0.25rem);
    z-index: 1;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    box-shadow: 0 -6px 18px rgb(0 0 0 / 0.25);
  }
  a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-1);
    text-decoration: none;
  }
  a:hover,
  a[aria-current="true"] {
    background: color-mix(in srgb, var(--docs-accent) 14%, transparent);
    color: var(--docs-accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
