---
/**
 * Starlight Header override: a slim top bar with the docs tabs (see docs.config.ts).
 * Logo, search, language and theme live in the sidebar; on mobile the logo also
 * shows here. The page offset comes from --sl-nav-height (see starlight.css).
 */
import SiteTitle from "virtual:starlight/components/SiteTitle";
import { docsConfig } from "../../config/docs.config";
import { docsLocaleOf, docsUi, l, tabHref, tabOfPath } from "../../lib/docs";

const locale = docsLocaleOf(Astro.url.pathname);
const active = tabOfPath(Astro.url.pathname);
---

<div class="bar">
  <div class="brand"><SiteTitle /></div>
  <nav class="tabs" aria-label={docsUi(locale).sections}>
    {
      docsConfig.tabs.map((tab) => (
        <a href={tabHref(locale, tab)} aria-current={tab.id === active.id ? "page" : undefined}>
          {l(locale, tab.label)}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    height: 100%;
    padding-inline: var(--sl-nav-pad-x);
  }
  .brand {
    width: 100%;
    height: 3rem;
    display: flex;
    align-items: center;
    /* room for the mobile menu button */
    padding-inline-end: calc(var(--sl-menu-button-size) + 1rem);
  }
  .tabs {
    display: flex;
    gap: 0.25rem;
    height: 2.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs a {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border-bottom: 2px solid transparent;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .tabs a:hover {
    color: var(--sl-color-white);
  }
  .tabs a[aria-current="page"] {
    color: var(--docs-accent-text);
    border-bottom-color: var(--docs-accent);
  }
  @media (min-width: 50rem) {
    .bar {
      flex-wrap: nowrap;
      gap: 1.5rem;
    }
    .brand {
      display: none;
    }
    .tabs {
      height: 100%;
    }
  }
</style>
