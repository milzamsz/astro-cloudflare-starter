---
import type { Locale } from "../../../../lib/site-config";
import { t } from "../../../../i18n/ui";

export interface Props {
  currentPage: number;
  totalPages: number;
  /**
   * Localized URL of page 1 (e.g. `resolveRoute(locale, "/blog/tag/astro")`).
   * Later pages are static routes at `${basePath}/page/N` — no query strings,
   * since the site is fully prerendered and search params never reach the build.
   */
  basePath: string;
  locale?: Locale;
}

const { currentPage, totalPages, basePath, locale = "en" } = Astro.props as Props;
const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
const root = basePath.replace(/\/+$/, "") || "/";

function pageHref(page: number) {
  if (page <= 1) return root;
  return `${root === "/" ? "" : root}/page/${page}`;
}
---

<nav
  class="ui-pagination"
  aria-label={`${t(locale, "pagination.page")} ${currentPage} ${t(locale, "pagination.of")} ${totalPages}`}
>
  {
    currentPage > 1 && (
      <a href={pageHref(currentPage - 1)}>{t(locale, "pagination.prev")}</a>
    )
  }
  <ol>
    {
      pages.map((page) => (
        <li>
          {page === currentPage ? (
            <span aria-current="page">{page}</span>
          ) : (
            <a href={pageHref(page)}>
              {t(locale, "pagination.page")} {page}
            </a>
          )}
        </li>
      ))
    }
  </ol>
  {
    currentPage < totalPages && (
      <a href={pageHref(currentPage + 1)}>{t(locale, "pagination.next")}</a>
    )
  }
</nav>

<style>
  .ui-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }
  .ui-pagination ol {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ui-pagination a,
  .ui-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    padding: 0 0.5rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid var(--color-border);
  }
</style>
