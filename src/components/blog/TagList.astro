---
import type { Locale } from "../../lib/site-config";
import { resolveRoute } from "../../i18n/routes";
import { t } from "../../i18n/ui";
import { slugifyTag } from "../../lib/tags";
import { Badge } from "../ui/index";

export interface Props {
  tags: string[];
  basePath?: string;
  locale?: Locale;
}

const { tags, basePath = "/blog", locale = "en" } = Astro.props as Props;
const href = (tag: string) => `${resolveRoute(locale, basePath)}?tag=${slugifyTag(tag)}`;
---

{
  tags.length > 0 && (
    <div
      class="blog-tags"
      aria-label={t(locale, "blog.tags")}
    >
      {tags.map((tag) => (
        <a href={href(tag)}>
          <Badge variant="outline">{tag}</Badge>
        </a>
      ))}
    </div>
  )
}

<style>
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .blog-tags a {
    text-decoration: none;
  }
</style>
